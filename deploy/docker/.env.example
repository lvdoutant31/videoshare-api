# Set these to the existing MySQL and Redis instances used by videoshare.
# If both run on the Docker host, host.docker.internal resolves through Compose.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3306
MYSQL_DATABASE=yingliu-db
MYSQL_USER=CHANGE_ME
MYSQL_PASSWORD=CHANGE_ME

REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=

# Internal HTTP port; forward public HTTPS traffic to this port at the gateway.
WEB_PORT=8092
