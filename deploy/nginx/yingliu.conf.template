# Rendered by deploy/build-release.ps1. Paths use forward slashes because this
# configuration targets Nginx for Windows.

server {
    listen __LISTEN_PORT__ ssl;
    # Match the public hostname as well as direct LAN/localhost checks. This
    # prevents requests with an IP/alternate Host header from falling into a
    # different Nginx server block and returning its 404 page.
    server_name __PUBLIC_HOST__ ysd-hsdy.com.cn localhost 127.0.0.1 10.2.0.23;
    absolute_redirect off;

    ssl_certificate __SSL_CERTIFICATE__;
    ssl_certificate_key __SSL_CERTIFICATE_KEY__;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:YingliuSSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;

    client_max_body_size 500m;
    client_body_timeout 600s;

    location = /videoshare {
        return 301 /videoshare/h5/;
    }

    location = /videoshare/ {
        return 301 /videoshare/h5/;
    }

    location = /videoshare/h5 {
        return 301 /videoshare/h5/;
    }

    location = /videoshare/h5/ {
        rewrite ^ /_yingliu_h5_index last;
    }

    location /videoshare/h5/ {
        rewrite ^/videoshare(/h5/.*)$ $1 break;
        root __DEPLOY_ROOT__/frontend;
        try_files $uri $uri/ /_yingliu_h5_index;
    }

    location = /_yingliu_h5_index {
        internal;
        alias __DEPLOY_ROOT__/frontend/h5/index.html;
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
    }

    location = /videoshare/admin {
        return 301 /videoshare/admin/;
    }

    location = /videoshare/admin/ {
        rewrite ^ /_yingliu_admin_index last;
    }

    location /videoshare/admin/ {
        rewrite ^/videoshare(/admin/.*)$ $1 break;
        root __DEPLOY_ROOT__/frontend;
        try_files $uri $uri/ /_yingliu_admin_index;
    }

    location = /_yingliu_admin_index {
        internal;
        alias __DEPLOY_ROOT__/frontend/admin/index.html;
        default_type text/html;
        charset utf-8;
        add_header Cache-Control "no-store" always;
    }

    location ~* ^/videoshare/(h5|admin)(/.*\.(?:css|js|jpg|jpeg|gif|png|svg|ico|webp|woff|woff2|ttf|eot))$ {
        rewrite ^/videoshare(/.*)$ $1 break;
        root __DEPLOY_ROOT__/frontend;
        expires 7d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location = /h5 {
        return 301 /videoshare/h5/;
    }

    location = /admin {
        return 301 /videoshare/admin/;
    }

    location /h5/ {
        return 301 /videoshare$request_uri;
    }

    location /admin/ {
        return 301 /videoshare$request_uri;
    }

    location /api/ {
        return 308 /videoshare$request_uri;
    }

    location = /health {
        return 301 /videoshare/health;
    }

    location /media/ {
        return 301 /videoshare$request_uri;
    }

    location /videoshare/api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_connect_timeout 30s;
        proxy_send_timeout 600s;
        proxy_read_timeout 600s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Cookie $http_cookie;
        proxy_pass_header Set-Cookie;
        proxy_cookie_flags yingliu-admin-session httponly secure samesite=lax;
    }

    location = /videoshare/health {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location /videoshare/media/ {
        alias __DEPLOY_ROOT__/media/;
        sendfile on;
        autoindex off;
        add_header Accept-Ranges bytes always;
        add_header Access-Control-Allow-Origin "*" always;
        add_header Access-Control-Allow-Methods "GET, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Range" always;
        add_header Access-Control-Expose-Headers "Content-Length, Content-Range, Accept-Ranges" always;
        add_header Cache-Control "public, max-age=604800, immutable" always;
        if ($request_method = OPTIONS) { return 204; }
        limit_except GET OPTIONS { deny all; }
    }

    location = / {
        return 302 /videoshare/h5/;
    }

    location / {
        return 302 /videoshare/h5/;
    }
}
