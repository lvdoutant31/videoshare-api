# 复制为 .env 后填写本地环境；仅 local profile 自动读取工程根目录 .env。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=yingliu-db
MYSQL_USER=root
MYSQL_PASSWORD=change-me-local-only
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
APP_PORT=8080
MEDIA_STORAGE_TYPE=local
MEDIA_ROOT=document/media
MEDIA_MAX_VIDEO_SIZE=500MB
MEDIA_MAX_REQUEST_SIZE=500MB
MEDIA_MAX_VIDEO_SIZE_BYTES=524288000
YINGLIU_LOCAL_SEED_ENABLED=false
YINGLIU_ADMIN_AUTH_DISABLED=true
YINGLIU_ADMIN_AUTH_BYPASS_ADMIN_ID=9000001
YINGLIU_ADMIN_CORS_ALLOWED_ORIGIN=
YINGLIU_ADMIN_COOKIE_SECURE=false
# 切换到 OSS 模式时填写以下配置。callback 必须能被 OSS 服务访问。
OSS_ENDPOINT=
OSS_REGION=cn-shanghai
OSS_STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_URL_PREFIX=
OSS_CALLBACK_URL=
OSS_STS_ROLE_ARN=
OSS_UPLOAD_DIR=dir/
OSS_SIGNATURE_EXPIRE_SECONDS=3600

# 企业微信网页授权（真实环境填写；Secret 和身份密钥不要提交到 Git）。
WECOM_ENABLED=false
WECOM_MOCK_ENABLED=true
WECOM_CORP_ID=
WECOM_AGENT_ID=0
WECOM_SECRET=
WECOM_REDIRECT_URI=
WECOM_IDENTITY_KEY=
WECOM_STATE_TTL_SECONDS=300
# 本机 HTTP 可用 false；生产配置固定使用 Secure Cookie。
WECOM_COOKIE_SECURE=false

# Local Nginx video serving
MEDIA_LOCAL_URL_PREFIX=/media
MEDIA_HTTP_PORT=8088
MEDIA_BIND_ADDRESS=127.0.0.1
